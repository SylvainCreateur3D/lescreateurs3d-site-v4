# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Your Stripe API Secret Key (e.g. sk_live_... or sk_test_...).
# Get this from your Stripe Dashboard > Developers > API Keys.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Your Stripe Webhook Signature Secret (e.g. whsec_...).
# Get this from your Stripe Dashboard > Developers > Webhooks after adding your webhook endpoint.
# If left empty, the application will process events in test/preview mode without signature checks.
STRIPE_WEBHOOK_SECRET=""

# SKOOL_API_KEY: Your School (Skool) Developer API Key (Bearer Token).
# Get this from your School settings under Developer APIs.
SKOOL_API_KEY=""

# SKOOL_GROUP_ID: The unique identifier of your School group.
# Look for this in your School group settings URL or profile.
SKOOL_GROUP_ID=""

# ADMIN_PASSWORD: Plaintext passcode fallback for admin login when Google Auth is restricted
# Default value is "admin3d" if left empty or not provided.
ADMIN_PASSWORD=""

